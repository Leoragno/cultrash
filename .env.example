# "rest" (predefinito) usa il server incluso: è quello che serve per giocare
# su più dispositivi. "local" usa localStorage e funziona solo fra schede
# dello stesso browser, comodo mentre sviluppi da solo.
VITE_SYNC=rest

# Da valorizzare solo se il server sta su un dominio diverso dal front.
# VITE_API_URL=https://cultrash-api.esempio.dev/api

# Porta del server di sincronizzazione.
PORT=8787
