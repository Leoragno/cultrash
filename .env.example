# "appwrite" usa Appwrite Database: niente server da avviare, il browser
# parla direttamente con Appwrite (vedi variabili sotto). "rest" usa il
# server incluso in server/index.js. "local" usa localStorage e funziona
# solo fra schede dello stesso browser, comodo mentre sviluppi da solo.
VITE_SYNC=appwrite

# Necessarie solo con VITE_SYNC=appwrite. Project ID ed endpoint si trovano
# in Appwrite Console → Settings del progetto. Database/Collection sono
# quelli creati per Cultrash (id "cultrash" / "kv" se non li hai cambiati).
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=cultrash
VITE_APPWRITE_COLLECTION_ID=kv

# Da valorizzare solo con VITE_SYNC=rest e server su un dominio diverso dal front.
# VITE_API_URL=https://cultrash-api.esempio.dev/api

# Porta del server di sincronizzazione (solo VITE_SYNC=rest).
PORT=8787
